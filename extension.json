{
	"name": "AVIF",
	"version": "0.7.0",
	"author": [
		"tesinormed"
	],
	"url": "https://www.mediawiki.org/wiki/Extension:AVIF",
	"descriptionmsg": "avif-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "media",
	"requires": {
		"MediaWiki": ">= 1.43.0",
		"platform": {
			"php": ">= 8.1"
		}
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\AVIF\\": "src/"
	},
	"config": {
		"AVIFSaveOptions": {
			"value": {
				"strip": "true",
				"Q": "90"
			}
		}
	},
	"ConfigRegistry": {
		"avif": "GlobalVarConfig::newInstance"
	},
	"HookHandlers": {
		"file": {
			"class": "MediaWiki\\Extension\\AVIF\\FileHooks",
			"services": [
				"RepoGroup"
			]
		}
	},
	"Hooks": {
		"PageMoveComplete": "file",
		"FileDeleteComplete": "file"
	},
	"JobClasses": {
		"AvifTransform": {
			"class": "MediaWiki\\Extension\\AVIF\\AvifTransformJob",
			"services": [
				"ConfigFactory",
				"RepoGroup",
				"TempFSFileFactory"
			],
			"needsPage": false
		}
	},
	"AvailableRights": [
		"aviftransform"
	],
	"GroupPermissions": {
		"*": {
			"aviftransform": false
		},
		"sysop": {
			"aviftransform": true
		}
	},
	"SpecialPages": {
		"AVIF": {
			"class": "MediaWiki\\Extension\\AVIF\\SpecialAvif",
			"services": [
				"JobQueueGroupFactory",
				"JobFactory"
			]
		}
	},
	"MessagesDirs": {
		"AVIF": [
			"i18n"
		]
	},
	"ExtensionMessagesFiles": {
		"AVIFAlias": "AVIF.i18n.alias.php"
	},
	"manifest_version": 2,
	"load_composer_autoloader": true
}
